{
  "license": "MIT",
  "author": "Alask-Code",
  "name": "voxel-world",
  "version": "0.0.117-pre-alpha",
  "main": "dist-electron/app.js",
  "productName": "Voxel World",
  "description": "Jogo sandbox voxel independente para desktop.",
  "build": {
    "asar": true,
    "files": [
      "dist-electron",
      "dist-vite"
    ],
    "directories": {
      "buildResources": "resources"
    }
  },
  "scripts": {
    "start": "vite",
    "test": "tsc -p tsconfig.test.json && node .test-build/tests/run.js && node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "build:vite": "vite build",
    "build:electron": "tsc -p electron",
    "lint": "eslint . --ext ts,tsx --fix",
    "dist": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir",
    "dev:electron": "npm run build:electron && electron .",
    "build": "npm run build:vite && npm run build:electron"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.1.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@vitejs/plugin-react": "^1.2.0",
    "electron-is-dev": "^2.0.0",
    "r3f-perf": "^7.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.2.0",
    "three": "^0.175.0",
    "three-stdlib": "^2.36.1",
    "vite": "^2.8.6",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^17.0.22",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.2",
    "@types/react-router-dom": "^5.3.3",
    "@types/three": "^0.175.0",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "autoprefixer": "^10.4.4",
    "electron": "^30.0.7",
    "electron-builder": "^24.13.3",
    "eslint": "8.57.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "4.0.0",
    "eslint-plugin-react": "^7.29.4",
    "eslint-plugin-tailwindcss": "4.0.2",
    "gltfjsx": "6.2.14",
    "postcss": "^8.4.12",
    "prettier": "2.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^4.6.2"
  },
  "allowScripts": {
    "electron@30.5.1": true,
    "esbuild@0.14.54": true,
    "sharp@0.32.6": true
  }
}
